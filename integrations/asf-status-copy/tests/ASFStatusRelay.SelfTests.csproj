  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/RichPresenceCodec.cs" Link="RichPresenceCodec.cs" />
    <Reference Include="SteamKit2"><HintPath>$(ASFDirectory)/SteamKit2.dll</HintPath></Reference>
    <Reference Include="protobuf-net"><HintPath>$(ASFDirectory)/protobuf-net.dll</HintPath></Reference>
    <Reference Include="protobuf-net.Core"><HintPath>$(ASFDirectory)/protobuf-net.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
