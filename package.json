{
  "name": "steam-friend-commenter",
  "version": "0.3.0",
  "description": "XiaoLan Steam Toolbox: local artwork tools, multi-account friends, history, and profile comments.",
  "main": "out/main/index.js",
  "author": {
    "name": "XiaoLan9999",
    "url": "https://xiaolan9999.net"
  },
  "homepage": "https://xiaolan9999.net",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run test && npm run build && electron-builder --win nsis portable",
    "dist:dir": "npm run test && npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.0",
    "parse5": "8.0.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "steam-session": "1.9.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
